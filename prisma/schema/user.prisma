model User {
    id             String   @id @default(uuid())
    name           String?
    email          String   @unique
    password       String?
    phone          String?
    image          String?
    role           Role     @default(CUSTOMER)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    accounts       Accout[]
    orders         Order[]  @relation("CustomerOrders")
    assignedOrders Order[]  @relation("RiderOrders")

    @@index([role])
    @@map("users")
}
